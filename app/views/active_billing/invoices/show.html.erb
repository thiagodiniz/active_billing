<%
  state_badge_class = case @invoice.state
  when "issued"     then "bg-green-500/10 text-green-400 ring-green-500/30"
  when "processing" then "bg-blue-500/10 text-blue-400 ring-blue-500/30"
  when "cancelled"  then "bg-gray-500/10 text-gray-400 ring-gray-500/30"
  when "failed"     then "bg-red-500/10 text-red-400 ring-red-500/30"
  else                   "bg-yellow-500/10 text-yellow-400 ring-yellow-500/30"
  end
%>

<header class="relative isolate">
  <div aria-hidden="true" class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute top-full left-16 -mt-16 transform-gpu opacity-30 blur-3xl xl:left-1/2 xl:-ml-80">
      <div style="clip-path: polygon(100% 38.5%, 82.6% 100%, 60.2% 37.7%, 52.4% 32.1%, 47.5% 41.8%, 45.2% 65.6%, 27.5% 23.4%, 0.1% 35.3%, 17.9% 0%, 27.7% 23.4%, 76.2% 2.5%, 74.2% 56%, 100% 38.5%)" class="aspect-1154/678 w-288.5 bg-linear-to-br from-[#FF80B5] to-[#9089FC]"></div>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-white/5"></div>
  </div>

  <div class="py-6">
    <div class="flex max-w-none items-center justify-between gap-x-8">
      <div class="flex items-center gap-x-6">
        <h1>
          <div class="text-sm/6 text-gray-400"><%= t("active_billing.invoice.show_title", default: "Invoice") %> <span class="text-gray-300"><%= @invoice.uuid %></span></div>
        </h1>
        <span class="rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= state_badge_class %>">
          <%= t("active_billing.invoice.states.#{@invoice.state}", default: @invoice.state.humanize) %>
        </span>
      </div>
      <div class="flex items-center gap-x-4 sm:gap-x-6">
        <%= link_to t("active_billing.back", default: "Back"), invoices_path(current_scope_params), class: "text-sm/6 font-semibold text-gray-300 hover:text-white" %>
      </div>
    </div>
  </div>
</header>

<div class="mt-8 grid grid-cols-1 grid-rows-1 items-start gap-x-8 gap-y-8 lg:grid-cols-3">
  <div class="lg:col-start-3 lg:row-end-1">
    <h2 class="sr-only"><%= t("active_billing.invoice.summary", default: "Summary") %></h2>
    <div class="rounded-lg bg-gray-800/50 shadow-xs ring-1 ring-white/10">
      <dl class="flex flex-wrap">
        <div class="flex-auto pt-6 pl-6">
          <dt class="text-sm/6 font-semibold text-white"><%= t("active_billing.invoice.amount", default: "Amount") %></dt>
          <dd class="mt-1 text-base font-semibold text-white"><%= format_cents(@invoice.amount_in_cents) %></dd>
        </div>
        <div class="flex-none self-end px-6 pt-4">
          <dt class="sr-only"><%= t("active_billing.invoice.state", default: "State") %></dt>
          <dd class="rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= state_badge_class %>">
            <%= t("active_billing.invoice.states.#{@invoice.state}", default: @invoice.state.humanize) %>
          </dd>
        </div>
        <% if @invoice.issued_at.present? %>
          <div class="mt-6 flex w-full flex-none gap-x-4 border-t border-white/10 px-6 pt-6">
            <dt class="flex-none">
              <span class="sr-only"><%= t("active_billing.invoice.issued_at", default: "Issued at") %></span>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-6 w-5 text-gray-500">
                <path d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
            </dt>
            <dd class="text-sm/6 text-gray-400"><time datetime="<%= @invoice.issued_at.iso8601 %>"><%= @invoice.issued_at.strftime("%B %-d, %Y") %></time></dd>
          </div>
        <% end %>
        <% if @invoice.description.present? %>
          <div class="mt-4 flex w-full flex-none gap-x-4 px-6 pb-6">
            <dt class="sr-only"><%= t("active_billing.invoice.description", default: "Description") %></dt>
            <dd class="text-sm/6 text-gray-400"><%= @invoice.description %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <div class="-mx-4 px-4 py-8 shadow-xs ring-1 ring-white/10 sm:mx-0 sm:rounded-lg sm:px-8 sm:pb-14 lg:col-span-2 lg:row-span-2 lg:row-end-2 xl:px-16 xl:pt-16 xl:pb-20">
    <h2 class="text-base font-semibold text-white"><%= t("active_billing.invoice.show_title", default: "Invoice") %></h2>
    <dl class="mt-6 grid grid-cols-1 text-sm/6 sm:grid-cols-2">
      <% if @invoice.issued_at.present? %>
        <div class="sm:pr-4">
          <dt class="inline text-gray-400"><%= t("active_billing.invoice.issued_at", default: "Issued on") %> </dt>
          <dd class="inline text-gray-300"><time datetime="<%= @invoice.issued_at.iso8601 %>"><%= @invoice.issued_at.strftime("%B %-d, %Y") %></time></dd>
        </div>
      <% end %>
      <% if @invoice.description.present? %>
        <div class="mt-2 sm:mt-0 sm:pl-4">
          <dt class="inline text-gray-400"><%= t("active_billing.invoice.description", default: "Description") %> </dt>
          <dd class="inline text-gray-300"><%= @invoice.description %></dd>
        </div>
      <% end %>
    </dl>

    <h3 class="mt-10 text-sm font-semibold text-white"><%= t("active_billing.invoice.items", default: "Line items") %></h3>

    <% if @invoice.items.empty? %>
      <p class="mt-4 text-sm text-gray-400"><%= t("active_billing.invoice.no_items", default: "No line items.") %></p>
    <% else %>
      <table class="mt-4 w-full text-left text-sm/6 whitespace-nowrap">
        <colgroup>
          <col class="w-full" />
          <col />
          <col />
          <col />
        </colgroup>
        <thead class="border-b border-white/15 text-white">
          <tr>
            <th scope="col" class="px-0 py-3 font-semibold"><%= t("active_billing.invoice_item.key", default: "Item") %></th>
            <th scope="col" class="hidden py-3 pr-0 pl-8 text-right font-semibold sm:table-cell"><%= t("active_billing.invoice_item.quantity", default: "Qty") %></th>
            <th scope="col" class="hidden py-3 pr-0 pl-8 text-right font-semibold sm:table-cell"><%= t("active_billing.invoice_item.unit_price", default: "Unit price") %></th>
            <th scope="col" class="py-3 pr-0 pl-8 text-right font-semibold"><%= t("active_billing.invoice_item.price", default: "Price") %></th>
          </tr>
        </thead>
        <tbody>
          <% @invoice.items.each do |item| %>
            <tr class="border-b border-white/10">
              <td class="max-w-0 px-0 py-5 align-top">
                <div class="truncate font-medium text-white"><%= item.key %></div>
              </td>
              <td class="hidden py-5 pr-0 pl-8 text-right align-top text-gray-300 tabular-nums sm:table-cell"><%= item.quantity %></td>
              <td class="hidden py-5 pr-0 pl-8 text-right align-top text-gray-300 tabular-nums sm:table-cell"><%= item.unit_price %></td>
              <td class="py-5 pr-0 pl-8 text-right align-top text-gray-300 tabular-nums"><%= item.price %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="3" class="hidden px-0 pt-6 pb-0 text-right font-normal text-gray-400 sm:table-cell"><%= t("active_billing.invoice.total", default: "Total") %></th>
            <th scope="row" class="px-0 pt-6 pb-0 font-normal text-gray-400 sm:hidden"><%= t("active_billing.invoice.total", default: "Total") %></th>
            <td class="pt-6 pr-0 pb-0 pl-8 text-right font-semibold text-white tabular-nums"><%= format_cents(@invoice.amount_in_cents) %></td>
          </tr>
        </tfoot>
      </table>
    <% end %>
  </div>

  <div class="lg:col-start-3">
    <%= link_to "← #{t("active_billing.back", default: "Back to invoices")}", invoices_path(current_scope_params), class: "text-sm/6 font-semibold text-indigo-400 hover:text-indigo-300" %>
  </div>
</div>
